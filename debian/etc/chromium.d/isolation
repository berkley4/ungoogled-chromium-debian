# Enable experimental support for isolated web apps
# See https://github.com/reillyeon/isolated-web-apps for more information
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-isolated-web-apps"

# Out-of-Process iframes (OOPIFs) for the PDF Viewer
# See - https://www.chromium.org/developers/design-documents/oop-iframes/
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-features=PdfOopif"


