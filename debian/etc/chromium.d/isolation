# General info: some of these prefs might be already covered by existing
# patches. However, it probably won't hurt to enable some of these, even
# if they've been pre-enabled via patch.

# Disables site isolation (SitePerProcess, IsolateOrigins, etc).
# Intended for diagnosing bugs that may be due to out-of-process iframes.
#export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --site-isolation-trial-opt-out"

# Note: this breaks the document.domain feature of websites which itself 
#       is in the process of being obsoleted due to security concerns.
#       Ref - https://developer.chrome.com/blog/immutable-document-domain/
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --strict-origin-isolation"

# Enable experimental support for isolated web apps.
# See https://github.com/reillyeon/isolated-web-apps for more information
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-isolated-web-apps"

# Prevent out-of-process iframes from reusing compatible processes from
# unrelated tabs. This will result in more processes being created.
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --disable-process-reuse"

# Enable partitioning of third-party storage by top-level site.
# Note: under active development and may result in unexpected behavior.
#export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --third-party-storage-partitioning"

# Cromite feature (non-free builds only): "Verifies that the blob was created
# with the same top frame URL or, if not defined, by the same agent cluster."
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-features=EnforceNoopenerOnBlobURLNavigation"
