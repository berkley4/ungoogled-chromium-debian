@@ -414,8 +422,12 @@
        .destination = Transport::kBroker},
       *transport_endpoint,
       {
-          .is_peer_trusted = true,
+          // An elevated process is more privileged than the inviting broker, so
+          // it does not implicitly trust that broker. The broker on the other
